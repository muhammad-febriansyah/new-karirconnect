# KarirConnect web server. Caddy gets and renews the HTTPS certificate for
# APP_DOMAIN automatically (ports 80 and 443 must reach this container).
{
	email {$ACME_EMAIL}
	servers {
		# Only Caddy talks to php-fpm; requests from the internet arrive here.
		trusted_proxies static private_ranges
	}
}

{$APP_DOMAIN} {
	import /etc/caddy/app.caddy
}

# Redirect www to the bare domain (only if you point www here too).
www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}
