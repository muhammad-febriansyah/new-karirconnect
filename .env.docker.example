# ---------------------------------------------------------------------------
# KarirConnect — production .env for docker-compose.prod.yml
# Copy to .env on the server and fill in every CHANGE_ME.
# ---------------------------------------------------------------------------

APP_NAME=KarirConnect
APP_ENV=production
APP_DEBUG=false
APP_KEY=CHANGE_ME_run_php_artisan_key_generate_show
APP_URL=https://karirconnect.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

# Caddy: domain to serve and the email Let's Encrypt contacts about certificates.
APP_DOMAIN=karirconnect.id
ACME_EMAIL=CHANGE_ME@karirconnect.id

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# MySQL runs in the "mysql" container.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=karirconnect
DB_USERNAME=karirconnect
DB_PASSWORD=CHANGE_ME_long_random
DB_ROOT_PASSWORD=CHANGE_ME_long_random

# Redis runs in the "redis" container.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_long_random

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Job scraper queue: its own Redis queue with a long retry_after.
CRAWLER_QUEUE_DRIVER=redis
CRAWLER_QUEUE=crawler
CRAWLER_USER_AGENT="KarirConnectBot/1.0 (+https://karirconnect.id/bot)"

# Security headers (A+ on securityheaders.com). Report-only while testing a
# new third-party script.
SECURITY_CSP_REPORT_ONLY=false
SECURITY_HSTS_ENABLED=true

# Mail (SMTP), also used to forward applications for external jobs.
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@karirconnect.id
MAIL_FROM_NAME="${APP_NAME}"

# Copy the rest of the current production .env here as well (Firebase,
# Midtrans, Google OAuth, OpenAI, JWT, contact form recipient, ...).
